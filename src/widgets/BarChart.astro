---
import { IconRenderer } from "../textures/IconRenderer";

interface Category {
  label: string;
  icon?: string;
}

type ChartColor = "blue" | "orange" | "aqua" | "yellow" | "red" | "gray";

type Layout = "grouped" | "panels";

interface Series {
  name: string;
  values: readonly number[];
  color?: ChartColor;
  stack?: string;
}

interface Props {
  categories: readonly Category[];
  series: readonly Series[];
  title?: string;
  unit?: string;
  layout?: Layout;
}

const { categories, series, title, unit, layout = "grouped" } = Astro.props;

const paletteOrder: readonly ChartColor[] = ["blue", "orange", "aqua", "yellow"];

const colors = series.map(({ name, color }, index) => {
  const resolved = color ?? paletteOrder[index];

  if (resolved === undefined) {
    throw new Error(`BarChart series "${name}" needs a colour: only the first ${paletteOrder.length} have one by default`);
  }

  return resolved;
});

for (const { name, values } of series) {
  if (values.length !== categories.length) {
    throw new Error(`BarChart series "${name}" has ${values.length} values for ${categories.length} categories`);
  }
}

const stacks = [
  ...Map.groupBy(series.entries(), ([index, { stack }]) => stack ?? `series ${index}`).values(),
].map((members) => members.map(([index]) => index));
const stackTotal = (stack: readonly number[], categoryIndex: number) =>
  stack.reduce((total, index) => total + series[index]!.values[categoryIndex]!, 0);
const stackMax = (stack: readonly number[]) =>
  Math.max(...categories.map((_, categoryIndex) => stackTotal(stack, categoryIndex)));
const panels = layout === "panels" ? stacks.map((stack) => [stack]) : [stacks];
const panelMaxes = panels.map((panel) => Math.max(...panel.map(stackMax)));

const icons = IconRenderer.fromEnvironment();
const format = (value: number) => String(Number(value.toFixed(2)));
const unitSuffix = unit === undefined ? "" : ` ${unit}`;
const rows = categories.map((category, categoryIndex) => ({
  category,
  cells: panels.map((panel, panelIndex) =>
    panel.map((stack) => {
      const total = stackTotal(stack, categoryIndex);

      return {
        total: format(total),
        ratio: total / panelMaxes[panelIndex]!,
        segments: stack.map((index) => {
          const { name, values } = series[index]!;
          const value = values[categoryIndex]!;

          return {
            color: colors[index]!,
            share: value / total,
            value: format(value),
            description: `${category.label} · ${name}: ${format(value)}${unitSuffix}`,
          };
        }),
      };
    }),
  ),
}));
---

<figure class="bar-chart">
  {title !== undefined && <figcaption>{title}</figcaption>}
  <div class="bar-chart-rows" style={`--panels: ${panels.length};`}>
    {
      rows.map(({ category, cells }) => (
        <div class="bar-chart-row">
          <span class="bar-chart-label">
            {category.icon !== undefined && <img src={icons.resolve(category.icon).path} alt="" width="16" height="16" />}
            {category.label}
          </span>
          {cells.map((lines) => (
            <span class="bar-chart-bars">
              {lines.map((line) => (
                <span class="bar-chart-line">
                  <span class="bar-chart-bar" style={`--ratio: ${line.ratio};`}>
                    {line.segments.map((segment) => (
                      <span
                        class="bar-chart-segment"
                        data-color={segment.color}
                        style={`flex-grow: ${segment.share};`}
                        title={line.segments.length > 1 ? undefined : segment.description}
                      >
                        {line.segments.length > 1 && <span class="bar-chart-segment-value">{segment.value}</span>}
                      </span>
                    ))}
                  </span>
                  <span class="bar-chart-value">{line.total}</span>
                </span>
              ))}
            </span>
          ))}
        </div>
      ))
    }
  </div>
  {
    series.length > 1 && (
      <ul class="bar-chart-legend">
        {series.map(({ name }, index) => (
          <li>
            <span class="bar-chart-swatch" data-color={colors[index]} />
            {name}
          </li>
        ))}
      </ul>
    )
  }
</figure>
