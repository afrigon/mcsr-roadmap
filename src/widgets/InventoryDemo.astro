---
import { InputSequence } from "../inventory/InputSequence";
import { InventoryScreen } from "../inventory/InventoryScreen";
import { InventoryState } from "../inventory/InventoryState";
import type { ItemStack } from "../inventory/ItemStack";
import { Modifier } from "../inventory/Modifier";
import { Slot } from "../inventory/Slot";
import { SlotSection } from "../inventory/SlotSection";
import { IconRenderer } from "../textures/IconRenderer";

type Container = "chest";

interface Props {
  container: Container;
  slots: Readonly<Record<string, string>>;
  inputs: readonly string[];
  pace?: number;
  endPause?: number;
  title?: string;
}

const { slots, inputs: inputTexts, pace = 2, endPause = 1.5, title } = Astro.props;

const inputs = InputSequence.parse(inputTexts);
const initial = InventoryState.parse(slots);
const screen = new InventoryScreen(initial);
const snapshots = [{ state: initial, held: screen.heldControls }];

for (const [index, { text, input, delay }] of inputs.entries()) {
  try {
    screen.advance(delay);
    input.perform(screen);
  } catch (error) {
    throw new Error(`InventoryDemo input ${index + 1} "${text}": ${(error as Error).message}`);
  }

  snapshots.push({ state: screen.state, held: screen.heldControls });
}

const rows = [SlotSection.Chest, SlotSection.Inventory, SlotSection.Offhand, SlotSection.Hotbar].map((section) => ({
  section,
  slots: Slot.all(section),
}));
const slotKeys = ["F", ...Slot.all(SlotSection.Hotbar).map((slot) => String(slot.index))];
const keys = ["Q", Modifier.Shift, Modifier.Ctrl];
const modifiers: readonly string[] = Object.values(Modifier);

const icons = IconRenderer.fromEnvironment();
const iconPaths: string[] = [];
const iconIndex = (stack: ItemStack) => {
  const path = icons.resolve(stack.icon.key).path;

  if (!iconPaths.includes(path)) {
    iconPaths.push(path);
  }

  return iconPaths.indexOf(path);
};
const encode = (stack: ItemStack | null) => (stack === null ? null : [iconIndex(stack), stack.count]);
const frames = snapshots.map(({ state, held }) => ({
  slots: Object.fromEntries(
    rows.flatMap((row) => row.slots).flatMap((slot) => {
      const stack = state.get(slot);

      return stack === null ? [] : [[slot.key, encode(stack)]];
    }),
  ),
  cursor: encode(state.cursor),
  held,
}));
const steps = inputs.map(({ input }) => ({ pointer: input.pointer?.key ?? null, ripple: input.ripple }));
const demo = { pace, endPause, icons: iconPaths, frames, steps };
const speeds = [0.5, 1, 2];
const defaultSpeed = 1;
---

<figure class="inventory-demo" data-inventory-demo={JSON.stringify(demo)}>
  {title !== undefined && <figcaption>{title}</figcaption>}
  <div class="inventory-panel">
    {
      rows.map((row) => (
        <div class="inventory-grid" data-section={row.section}>
          {row.slots.map((slot) => {
            const stack = initial.get(slot);

            return (
              <span class="inventory-slot" data-slot={slot.key}>
                {stack !== null && <img src={iconPaths[iconIndex(stack)]} alt="" width="32" height="32" />}
                {stack !== null && stack.count > 1 && <span class="inventory-count">{stack.count}</span>}
              </span>
            );
          })}
        </div>
      ))
    }
    <div class="inventory-slot-keys">
      {
        slotKeys.map((key) => (
          <span class="inventory-slot-key">
            <kbd data-key={key} data-letter>
              {key}
            </kbd>
          </span>
        ))
      }
    </div>
    <div class="inventory-keys">
      {
        keys.map((key) => (
          <kbd data-key={key} data-letter={modifiers.includes(key) ? undefined : true}>
            {key}
          </kbd>
        ))
      }
    </div>
    <span class="inventory-pointer" aria-hidden="true">
      <svg viewBox="0 0 16 24" width="16" height="24">
        <path d="M1 1 L1 19 L5.5 14.5 L8.5 21.5 L11 20.5 L8 13.5 L14 13.5 Z" />
      </svg>
      <span class="inventory-held"></span>
    </span>
  </div>
  <div class="inventory-controls">
    <div class="tabs-list" role="group" aria-label="Playback">
      <button type="button" data-control="previous" aria-label="Previous input">‹</button>
      <button type="button" class="inventory-play" data-control="play">
        <span data-label="play">Play</span>
        <span data-label="pause">Pause</span>
      </button>
      <button type="button" data-control="next" aria-label="Next input">›</button>
    </div>
    <span class="inventory-progress" data-progress>0 / {inputs.length}</span>
    <div class="tabs-list" role="group" aria-label="Playback speed">
      {
        speeds.map((speed) => (
          <button type="button" data-speed={speed} aria-pressed={speed === defaultSpeed ? "true" : "false"}>
            {speed}×
          </button>
        ))
      }
    </div>
  </div>
</figure>

<script>
  import { InventoryDemoController } from "./InventoryDemoController";

  for (const demo of document.querySelectorAll<HTMLElement>("[data-inventory-demo]")) {
    new InventoryDemoController(demo).start();
  }
</script>
