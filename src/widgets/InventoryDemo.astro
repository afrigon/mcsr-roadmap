---
import { ContainerType } from "../inventory/ContainerType";
import { type InputEntry, InputSequence } from "../inventory/InputSequence";
import { DemoScreenFactory } from "../inventory/DemoScreenFactory";
import type { DragStage } from "../inventory/DragStage";
import { InventoryState } from "../inventory/InventoryState";
import type { ItemStack } from "../inventory/ItemStack";
import type { MenuSlot } from "../inventory/MenuSlot";
import { Modifier } from "../inventory/Modifier";
import { MouseButton } from "../inventory/MouseButton";
import type { Point } from "../inventory/Point";
import { RecipeBookState } from "../inventory/RecipeBookState";
import { ScreenKeys } from "../inventory/ScreenKeys";
import type { ScreenRectangle } from "../inventory/ScreenRectangle";
import { Slot } from "../inventory/Slot";
import { CountGlyphs } from "../textures/CountGlyphs";
import { IconRenderer } from "../textures/IconRenderer";
import { ItemCountFont } from "../textures/ItemCountFont";
import { DemoAlignment } from "./DemoAlignment";

interface Props {
  container: `${ContainerType}`;
  slots: Readonly<Record<string, string>>;
  inputs: readonly InputEntry[];
  book?: `${RecipeBookState}`;
  align?: `${DemoAlignment}`;
  selected?: number;
  pace?: number;
  endPause?: number;
  title?: string;
}

const {
  container,
  slots,
  inputs: inputTexts,
  book = RecipeBookState.Closed,
  align = DemoAlignment.Leading,
  selected,
  pace = 2,
  endPause = 1.5,
  title,
} = Astro.props;

const guiScale = 2;
const slotBox = 18;
const decorations: Record<ContainerType, { kind: string; area: ScreenRectangle }[]> = {
  [ContainerType.Hotbar]: [],
  [ContainerType.Chest]: [],
  [ContainerType.Inventory]: [
    { kind: "player", area: { x: 26, y: 8, width: 49, height: 70 } },
    { kind: "arrow", area: { x: 135, y: 29, width: 16, height: 13 } },
  ],
  [ContainerType.CraftingTable]: [{ kind: "arrow", area: { x: 89, y: 35, width: 22, height: 15 } }],
};

const containerType = Object.values(ContainerType).find((candidate) => candidate === container);
const bookState = Object.values(RecipeBookState).find((candidate) => candidate === book);
const alignment = Object.values(DemoAlignment).find((candidate) => candidate === align);

if (containerType === undefined) {
  throw new Error(`InventoryDemo container "${container}": expected ${Object.values(ContainerType).join(", ")}`);
}

if (bookState === undefined) {
  throw new Error(`InventoryDemo book "${book}": expected ${Object.values(RecipeBookState).join(", ")}`);
}

if (alignment === undefined) {
  throw new Error(`InventoryDemo align "${align}": expected ${Object.values(DemoAlignment).join(", ")}`);
}

const inputs = InputSequence.parse(inputTexts);
const initial = InventoryState.parse(slots);
const screen = DemoScreenFactory.create(containerType, initial, bookState, selected);

for (const slotName of Object.keys(slots)) {
  screen.checkStartingSlot(Slot.parse(slotName));
}

const snapshot = () => ({
  state: screen.displayedState,
  held: screen.heldControls,
  pointer: screen.pointer,
  hovered: screen.hoveredSlot,
  selected: screen.selectedSlot,
  book: screen.book,
  bookButtonFocused: screen.bookButtonHighlighted,
  dragged: screen.draggedSlots,
  stages: [] as DragStage[],
});
const snapshots = [snapshot()];
const doubleClicks: boolean[] = [];

for (const [index, { text, input, delay }] of inputs.entries()) {
  const pressesBefore = screen.doubleClickPresses.length;
  const stagesBefore = screen.dragStages.length;

  try {
    screen.advance(delay);
    input.perform(screen);
  } catch (error) {
    throw new Error(`InventoryDemo input ${index + 1} "${text}": ${(error as Error).message}`);
  }

  snapshots.push({ ...snapshot(), stages: screen.dragStages.slice(stagesBefore) });
  doubleClicks.push(screen.doubleClickPresses.slice(pressesBefore).includes(true));
}

const slotKeys = ["F", "1", "2", "3", "4", "5", "6", "7", "8", "9"];
const stackedKeyGroups = [
  ["Q", Modifier.Shift, Modifier.Ctrl],
  ["Tab", "Space", "T"],
];

const bookStates = [...new Set(snapshots.map((frame) => frame.book))];
const layouts = new Map(bookStates.map((state) => [state, screen.layoutFor(state)]));
const { leftPos, topPos, bookButton: screenBookButton } = screen.layoutFor(snapshots[0]!.book);
const bookPanel = [...layouts.values()].find((layout) => layout.bookPanel !== null)?.bookPanel ?? null;
const bookButton =
  screenBookButton === null ? null : { ...screenBookButton, x: screenBookButton.x - leftPos, y: screenBookButton.y - topPos };
const guiWindow = { x: 0, y: 0, width: screen.windowWidth, height: screen.windowHeight };
const slotArea = (slot: MenuSlot): ScreenRectangle => ({ x: slot.x - 1, y: slot.y - 1, width: slotBox, height: slotBox });
const guiAreas: ScreenRectangle[] = [
  guiWindow,
  ...screen.slots.map(slotArea),
  ...decorations[containerType].map((decoration) => decoration.area),
  ...(bookButton === null ? [] : [bookButton]),
];
const screenAreas = [
  ...[...layouts.values()].flatMap((layout) =>
    guiAreas.map((area) => ({ ...area, x: area.x + layout.leftPos, y: area.y + layout.topPos })),
  ),
  ...(bookPanel === null ? [] : [bookPanel]),
];
const origin = {
  x: Math.min(...screenAreas.map((area) => area.x)),
  y: Math.min(...screenAreas.map((area) => area.y)),
};
const extent = {
  width: Math.max(...screenAreas.map((area) => area.x + area.width)) - origin.x,
  height: Math.max(...screenAreas.map((area) => area.y + area.height)) - origin.y,
};
const place = (area: Point, base: Point = { x: 0, y: 0 }) =>
  `left: ${(area.x - base.x) * guiScale}px; top: ${(area.y - base.y) * guiScale}px;`;
const size = (area: { width: number; height: number }) =>
  `width: ${area.width * guiScale}px; height: ${area.height * guiScale}px;`;
const toScreen = (point: Point): [number, number] => [(point.x - origin.x) * guiScale, (point.y - origin.y) * guiScale];
const scaled = (area: ScreenRectangle) => [area.x, area.y, area.width, area.height].map((value) => value * guiScale);
const hoverAreas = {
  slots: Object.fromEntries(screen.slots.map((slot) => [slot.key, scaled(slotArea(slot))])),
  bookButton: bookButton === null ? null : scaled(bookButton),
};
const guiPositions = Object.fromEntries(
  [...layouts].map(([state, layout]) => [state, toScreen({ x: layout.leftPos, y: layout.topPos })]),
);

const icons = IconRenderer.fromEnvironment();
const iconPaths: string[] = [];
const iconIndex = (stack: ItemStack) => {
  const path = icons.resolve(stack.icon.key).path;

  if (!iconPaths.includes(path)) {
    iconPaths.push(path);
  }

  return iconPaths.indexOf(path);
};
const encode = (stack: ItemStack | null) => (stack === null ? null : [iconIndex(stack), stack.count]);
const display = (state: InventoryState, dragged: readonly MenuSlot[]) => ({
  slots: Object.fromEntries(
    screen.slots.flatMap((slot) => {
      const stack = state.get(slot.slot);

      return stack === null ? [] : [[slot.key, encode(stack)]];
    }),
  ),
  cursor: encode(state.cursor),
  dragged: dragged.map((slot) => slot.key),
});
const frames = snapshots.map(({ state, held, pointer, hovered, selected, book, bookButtonFocused, dragged, stages }) => ({
  ...display(state, dragged),
  stages: stages.map((stage) => ({ slot: stage.slot.key, ...display(stage.state, stage.dragged) })),
  held,
  pointer: pointer === null ? null : toScreen(pointer),
  hovered: hovered?.key ?? null,
  selected: selected?.key ?? null,
  book,
  bookButtonFocused,
}));
const inputViews = inputs.map(({ input: { ripple } }, index) => ({
  ripple,
  doubleClick: doubleClicks[index]!,
  actsOnSlot: ripple !== null && (ripple.target === "pointer" || ScreenKeys.actsOnSlot(ripple.key)),
}));
const stepEnds = inputs.flatMap(({ step }, index) => (inputs[index + 1]?.step === step ? [] : [index + 1]));
const countFont = ItemCountFont.fromEnvironment().metrics;
const countGlyphs = new CountGlyphs(countFont);
const bookIcon = icons.resolve("item/knowledge_book").path;
const demo = { pace, endPause, icons: iconPaths, frames, inputs: inputViews, stepEnds, countFont, guiPositions, hoverAreas };
const countSprite = `--count-sprite-width: ${countFont.cellWidth * countFont.characters.length}; --count-cell-height: ${countFont.cellHeight};`;
const speeds = [0.1, 0.5, 1, 2];
const defaultSpeed = 1;
---

<figure class="inventory-demo" data-inventory-demo={JSON.stringify(demo)} data-align={alignment} style={countSprite}>
  {title !== undefined && <figcaption>{title}</figcaption>}
  <div class="inventory-panel">
    <div class="inventory-screen" data-container={containerType} style={size(extent)}>
      {
        bookPanel !== null && (
          <span
            class="inventory-book"
            style={place(bookPanel, origin) + size(bookPanel)}
            hidden={snapshots[0]!.book === RecipeBookState.Closed}
          />
        )
      }
      <div class="inventory-gui" style={place({ x: leftPos, y: topPos }, origin) + size(guiWindow)}>
        {
          decorations[containerType].map((decoration) => (
            <span class="inventory-decoration" data-kind={decoration.kind} style={place(decoration.area) + size(decoration.area)} />
          ))
        }
        {
          bookButton !== null && (
            <span
              class="inventory-book-button"
              style={place(bookButton) + size(bookButton)}
              data-focused={snapshots[0]!.bookButtonFocused ? true : undefined}
            >
              <img src={bookIcon} alt="" width="16" height="16" />
            </span>
          )
        }
        {
          screen.slots.map((slot) => {
            const shown = snapshots[0]!.state.get(slot.slot);

            return (
              <span
                class="inventory-slot"
                data-slot={slot.key}
                style={place(slotArea(slot))}
              >
                {shown !== null && <img src={iconPaths[iconIndex(shown)]} alt="" width="32" height="32" />}
                {shown !== null && shown.count > 1 && (
                  <span class="inventory-count" aria-label={String(shown.count)}>
                    {countGlyphs.layout(shown.count).map((glyph) => (
                      <span
                        class="inventory-count-glyph"
                        style={`--offset: ${glyph.offset}; --advance: ${glyph.advance};`}
                      />
                    ))}
                  </span>
                )}
              </span>
            );
          })
        }
      </div>
      <span class="inventory-pointer" aria-hidden="true" hidden={screen.pointer === null}>
        <span class="inventory-held"></span>
        <svg viewBox="0 0 16 24" width="16" height="24">
          <path d="M1 1 L1 19 L5.5 14.5 L8.5 21.5 L11 20.5 L8 13.5 L14 13.5 Z" />
        </svg>
      </span>
    </div>
  </div>
  <div class="inventory-inputs">
    <div class="inventory-input-keys">
      <div class="inventory-key-group" data-group="slots">
        {
          slotKeys.map((key) => (
            <kbd data-key={key} data-letter>
              {key}
            </kbd>
          ))
        }
      </div>
      <div class="inventory-key-stack">
        {
          stackedKeyGroups.map((group) => (
            <div class="inventory-key-group">
              {group.map((key) => (
                <kbd data-key={key} data-letter={key.length === 1 ? true : undefined}>
                  {key}
                </kbd>
              ))}
            </div>
          ))
        }
      </div>
      <div class="inventory-mouse" aria-label="Mouse buttons">
        {[MouseButton.Left, MouseButton.Right].map((button) => <span data-key={button} data-button={button} />)}
      </div>
    </div>
    <div class="inventory-controls">
      <div class="tabs-list" role="group" aria-label="Playback">
        <button type="button" data-control="previous" aria-label="Previous input">‹</button>
        <button type="button" class="inventory-play" data-control="play">
          <span data-label="play">Play</span>
          <span data-label="pause">Pause</span>
        </button>
        <button type="button" data-control="next" aria-label="Next input">›</button>
      </div>
      <span class="inventory-progress" data-progress>0 / {stepEnds.length}</span>
      <div class="tabs-list" role="group" aria-label="Playback speed">
        {
          speeds.map((speed) => (
            <button type="button" data-speed={speed} aria-pressed={speed === defaultSpeed ? "true" : "false"}>
              {speed}×
            </button>
          ))
        }
      </div>
    </div>
  </div>
</figure>

<script>
  import { InventoryDemoController } from "./InventoryDemoController";

  for (const demo of document.querySelectorAll<HTMLElement>("[data-inventory-demo]")) {
    new InventoryDemoController(demo).start();
  }
</script>
