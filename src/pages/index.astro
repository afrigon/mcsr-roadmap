---
import { getCollection } from "astro:content";
import Canvas from "../components/Canvas.astro";
import Header from "../components/Header.astro";
import ItemPopover from "../components/ItemPopover.astro";
import Tooltip from "../components/Tooltip.astro";
import { CanvasLayout } from "../canvas/CanvasLayout";
import Layout from "../layouts/Layout.astro";
import { roadmapFile } from "../roadmap/RoadmapFiles";
import { RoadmapParser } from "../roadmap/RoadmapParser";

const roadmap = RoadmapParser.readFile(roadmapFile);
const layout = new CanvasLayout(roadmap);
const pages = new Map((await getCollection("items")).map((page) => [page.id, page]));
---

<Layout title="MCSR Ranked roadmap">
  <Header />
  <Canvas layout={layout} />
  <Tooltip />
  {roadmap.items.map((item) => <ItemPopover roadmap={roadmap} item={item} page={pages.get(item.id)} />)}
</Layout>
