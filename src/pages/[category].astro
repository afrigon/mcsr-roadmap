---
import { getCollection } from "astro:content";
import CategoryTabs from "../components/CategoryTabs.astro";
import ItemPopover from "../components/ItemPopover.astro";
import RowTimeline from "../components/RowTimeline.astro";
import Layout from "../layouts/Layout.astro";
import { roadmapFile } from "../roadmap/RoadmapFiles";
import { RoadmapParser } from "../roadmap/RoadmapParser";

export function getStaticPaths() {
  return RoadmapParser.readFile(roadmapFile).categories.map((category) => ({
    params: { category: category.id },
  }));
}

const roadmap = RoadmapParser.readFile(roadmapFile);
const category = roadmap.categories.find((candidate) => candidate.id === Astro.params.category)!;
const pages = new Map((await getCollection("items")).map((page) => [page.id, page]));
---

<Layout title={category.title}>
  <header class="px-6 pt-6 pb-4">
    <h1 class="mb-4 text-2xl font-semibold"><a href="/">MCSR Ranked roadmap</a></h1>
    <CategoryTabs categories={roadmap.categories} current={category} />
  </header>
  <main class="px-6 pb-12">
    {category.rows.map((row) => <RowTimeline roadmap={roadmap} row={row} category={category} />)}
  </main>
  {
    category.items.map((item) => (
      <ItemPopover roadmap={roadmap} item={item} category={category} page={pages.get(item.id)} />
    ))
  }
</Layout>
