---
import type { Category } from "../roadmap/Category";

interface Props {
  categories: readonly Category[];
  current: Category | null;
}

const { categories, current } = Astro.props;
---

<nav class="flex gap-1" aria-label="Categories">
  {
    categories.map((category) => (
      <a
        href={`/${category.id}`}
        aria-current={category === current ? "page" : undefined}
        class="bevel bg-panel-raised px-4 py-2 text-sm text-muted hover:text-text aria-[current=page]:bg-panel aria-[current=page]:text-title"
      >
        {category.title}
      </a>
    ))
  }
</nav>
