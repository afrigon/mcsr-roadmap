---
import { render, type CollectionEntry } from "astro:content";
import type { Item } from "../roadmap/Item";
import type { Roadmap } from "../roadmap/Roadmap";
import EditPageButton from "./EditPageButton.astro";
import StatusPicker from "./StatusPicker.astro";
import YouTube from "./YouTube.astro";
import BarChart from "../widgets/BarChart.astro";
import InventoryDemo from "../widgets/InventoryDemo.astro";
import Tab from "../widgets/Tab.astro";
import Tabs from "../widgets/Tabs.astro";

interface Props {
  roadmap: Roadmap;
  item: Item;
  page: CollectionEntry<"items">;
}

const { roadmap, item, page } = Astro.props;
const path = roadmap.pathTo(item);
const { Content } = await render(page);
const hasContent = (page.body ?? "").trim() !== "";
---

<div popover id={item.id} class="item-popover" data-item-popover>
  <div class="popover-scroll" data-popover-scroll>
    <header class="popover-head">
      <div class="frame frame-static" data-status-of={item.id}><img src={item.icon.path} alt="" width="32" height="32" /></div>
      <div class="popover-titles">
        <h2>
          {item.title}
          {item.label !== null && <span class="popover-label">{item.label}</span>}
        </h2>
        <p>{item.category.title} · {item.goal.title}</p>
      </div>
      {import.meta.env.DEV && <EditPageButton filePath={page.filePath!} />}
      <button type="button" class="popover-close" popovertarget={item.id} popovertargetaction="hide" aria-label="Close">
        <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
          <path d="M2 2 10 10 M10 2 2 10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
      </button>
    </header>

    {item.rankedNote !== null && <p class="ranked-label"><b>Ranked</b> {item.rankedNote}</p>}
    <StatusPicker item={item} />
    <p class="item-path">
      {path.map((step, index) => (index === path.length - 1 ? <b>{step.title}</b> : <span>{step.title} → </span>))}
    </p>
    <p class="item-description">{item.description}</p>
    <article class="item-page">
      {hasContent ? <Content components={{ YouTube, BarChart, InventoryDemo, Tabs, Tab }} /> : <p class="muted">No page yet.</p>}
    </article>
  </div>
</div>
