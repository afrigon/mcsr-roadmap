---
import type { GoalBracket } from "../canvas/GoalBracket";
import { BracketSize } from "../canvas/BracketSize";
import { goalIcon } from "../canvas/goalIcons";

interface Props {
  brackets: readonly GoalBracket[];
  width: number;
}

const { brackets, width } = Astro.props;
---

<div class="goals" style={`width: ${width}px;`} aria-hidden="true">
  {
    brackets.map((bracket) => (
      <div
        class="bracket"
        data-rank={bracket.goal.rank ?? "none"}
        data-bracket
        data-size={BracketSize.Full}
        style={`left: ${bracket.start}px; width: ${bracket.width}px;`}
      >
        <span>
          <img src={goalIcon(bracket.goal).path} alt="" width="14" height="14" />
          <b class="full">{bracket.goal.title}</b>
          <b class="short">{bracket.goal.shortTitle}</b>
        </span>
        <small data-goal-progress={bracket.goal.id} />
      </div>
    ))
  }
</div>
