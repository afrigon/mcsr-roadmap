---
import type { Item } from "../roadmap/Item";
import { Status, statusLabels } from "../status/Status";

interface Props {
  item: Item;
}

const { item } = Astro.props;
---

<div class="status-picker" role="group" aria-label="Status">
  {
    Object.values(Status).map((status) => (
      <button
        type="button"
        data-status-option={status}
        data-item-id={item.id}
        data-item-title={item.title}
        data-item-icon={item.icon.path}
        aria-pressed="false"
      >
        {statusLabels[status]}
      </button>
    ))
  }
</div>
