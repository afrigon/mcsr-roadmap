---
import type { Category } from "../roadmap/Category";
import type { Item } from "../roadmap/Item";
import { itemPath } from "../roadmap/itemPath";
import type { Roadmap } from "../roadmap/Roadmap";

interface Props {
  roadmap: Roadmap;
  item: Item;
  category: Category;
  note?: string;
}

const { roadmap, item, category, note } = Astro.props;
const href = itemPath(roadmap, item, category);
const Tag = href === null ? "button" : "a";
---

<li>
  <Tag
    type={href === null ? "button" : undefined}
    href={href ?? undefined}
    popovertarget={href === null ? item.id : undefined}
    data-status-of={item.id}
    class="group flex items-center gap-2 text-left text-link hover:underline"
  >
    <span
      class="h-2.5 w-2.5 shrink-0 bg-not-learned group-data-[status=practicing]:bg-practicing group-data-[status=mastered]:bg-mastered"
    ></span>
    {item.title}
    {note && <span class="text-xs text-muted">{note}</span>}
  </Tag>
</li>
