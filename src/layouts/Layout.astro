---
import AdvancementToast from "../components/AdvancementToast.astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <AdvancementToast />
    <script>
      import { BracketLabelController } from "../canvas/BracketLabelController";
      import { CanvasController } from "../canvas/CanvasController";
      import { CategoryRailController } from "../canvas/CategoryRailController";
      import { SearchController } from "../canvas/SearchController";
      import { TooltipController } from "../canvas/TooltipController";
      import { ViewMemory } from "../canvas/ViewMemory";
      import { StatusController } from "../status/StatusController";
      import { StatusStore } from "../status/StatusStore";

      const viewport = document.getElementById("viewport")!;

      const search = document.querySelector<HTMLElement>("[data-search]")!;

      new CanvasController(viewport).start();
      new CategoryRailController(
        document.querySelector<HTMLElement>("[data-category-rail]")!,
        viewport,
        document.getElementById("world")!,
      ).start();
      new BracketLabelController([...document.querySelectorAll<HTMLElement>("[data-bracket]")]).start();
      new SearchController(
        search,
        search.querySelector<HTMLInputElement>("[data-search-input]")!,
        search.querySelector<HTMLElement>("[data-search-count]")!,
        [...document.querySelectorAll<HTMLElement>("[data-frame]")],
      ).start();
      new TooltipController(viewport, document.getElementById("tooltip")!).start();
      new StatusController(document, StatusStore.fromWindow()).start();
      ViewMemory.fromWindow(viewport).start();
    </script>
  </body>
</html>
