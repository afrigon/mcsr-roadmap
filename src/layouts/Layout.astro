---
import AdvancementToast from "../components/AdvancementToast.astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · MCSR Ranked roadmap</title>
  </head>
  <body class="min-h-screen font-sans">
    <slot />
    <AdvancementToast />
    <script>
      import { StatusController } from "../status/StatusController";
      import { StatusStore } from "../status/StatusStore";

      new StatusController(document, StatusStore.fromWindow()).start();
    </script>
  </body>
</html>
