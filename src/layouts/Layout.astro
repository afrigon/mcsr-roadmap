---
import AdvancementToast from "../components/AdvancementToast.astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <AdvancementToast />
    <script>
      import { CanvasController } from "../canvas/CanvasController";
      import { TooltipController } from "../canvas/TooltipController";
      import { StatusController } from "../status/StatusController";
      import { StatusStore } from "../status/StatusStore";

      const viewport = document.getElementById("viewport")!;
      const world = document.getElementById("world")!;
      const all = (selector: string) => [...document.querySelectorAll<HTMLElement>(selector)];

      new CanvasController(viewport, world, all("[data-bracket]"), all("[data-band]"), all("[data-band-label]")).start();
      new TooltipController(world, document.getElementById("tooltip")!).start();
      new StatusController(document, StatusStore.fromWindow()).start();
    </script>
  </body>
</html>
