    item ocean-gravel title="Ocean Gravel" goal=sub30 parent=spawn-scouting icon="block/gravel" {
        description "Gravel from the ocean floor for flint."
    }
    item underwater-tnt title="Underwater TNT" goal=sub13 parent=ocean-gravel icon="block/tnt_side" label="Underwater" {
        description "TNT underwater for gravel and sand."
    }
