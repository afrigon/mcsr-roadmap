        description "Light the frame with flint and steel."
    }
    item lavaPool2Deep title="Lava Pool Portal" goal=firstCompletion parent=lightPortal icon="item/lava_bucket" label="2-deep" {
        description "Finish the frame, then remove the water."
    }
    item lavaPool1Deep title="Lava Pool Portal" goal=sub30 parent=lavaPool2Deep icon="item/lava_bucket" label="1-deep" {
        description "Build the portal on a pool only one block deep."
    }
    item lavaPoolDrain title="Drain While Building" goal=sub20 parent=lavaPool2Deep icon="item/lava_bucket" label="Drain" {
        description "Remove the water while placing the frame instead of after."
    }
    item magmaSmallL title="Magma Portal" goal=sub30 parent=lavaPool2Deep icon="block/magma" label="Small L" {
        description "A 2-deep small-L portal on a magma ravine."
    }
    item magma2x1 title="Magma Portal" goal=sub25 parent=magmaSmallL icon="block/magma" label="2×1" {
        description "The 2-deep 2×1 shape: fewer buckets, faster frame."
    }
    item magmaL1Deep title="Magma Portal" goal=sub20 parent=magmaSmallL icon="block/magma" label="L 1-deep" {
        description "The L shape on a 1-deep ravine."
    }
    item magma2x1OneDeep title="Magma Portal" goal=sub12 parent=magma2x1 icon="block/magma" label="2×1 1-deep" {
        description "The 2×1 shape on a 1-deep ravine."
    }
    item lebronPortal title="LeBron Portal" goal=sub10 parent=magma2x1OneDeep icon="block/magma" label="LeBron" {
        description "A 2×1 with lava placed before the block and no door."
    }
    item obsidianOnly title="Obsidian-Only Portal" goal=sub30 parent=lightPortal icon="block/obsidian" label="10 obsidian" {
        description "Build the portal from 10 obsidian, no lava needed."
    }
    item obsidianOnlyOptimal title="Obsidian-Only Portal" goal=sub13 parent=obsidianOnly icon="block/obsidian" label="Speed pillar" {
        description "A 4-tall speed pillar for the obsidian portal."
    }
    item caveLava title="Cave Lava" goal=sub25 parent=lightPortal icon="item/lava_bucket" label="Cave" {
        description "Find lava underground by sound and dig down to it."
    }
    item enterWithLava title="Enter with a Lava Bucket" goal=sub30 parent=lightPortal icon="item/lava_bucket" label="Enter" {
        description "Carry lava into the nether and eat during the portal animation."
    }
    item woodlightEasy title="Woodlight Portal" goal=sub20 parent=lightPortal icon="block/fire_0" label="Basic" {
        description "Light the portal by fire spreading from lava to wood beside the frame; saves the flint and steel."
    }
    item woodlightOptimal title="Woodlight Portal" goal=sub11 parent=woodlightEasy icon="block/fire_0" label="Modern" {
        description "Planks inside the frame with lava beside them, on Hard while waiting, so it lights sooner."
    }
    item flintKills title="Flint Kills" goal=sub45 icon="item/beef" {
        description "Kill animals with flint and steel and an axe."
    }
    item oneHitKills title="One-Hit Kills" goal=sub20 parent=flintKills icon="item/golden_axe" {
        description "One axe hit, wait for the animal to stop, then one tick of fire."
    }
    item lavaBucketKill title="Lava Bucket Kill" goal=sub25 parent=flintKills icon="item/lava_bucket" label="Kill" {
        description "Place lava in the animal's hitbox and pick it back up aiming outside the hitbox, so you don't milk the cow and the drops don't burn."
    }
    item waterHole title="Water Hole Trick" goal=sub15 parent=flintKills icon="item/water_bucket" {
        description "Pour water into a small hole beside a cow before lighting it; it runs there instead of to a lake and stays in reach."
    }
    item foodBasics title="Food Basics" goal=sub45 icon="composite/hunger" {
        description "Rotten flesh in the overworld, good food for the nether."
    }
    item spawnScouting title="F5 Scouting" goal=sub45 icon="item/map" {
        description "Look around in third person at spawn for lava, trees, animals and gravel."
    }
    item magmaRavinesEasy title="Magma Ravines" goal=sub30 parent=spawnScouting icon="item/kelp" label="Kelp" {
        description "Spot magma ravines by floating kelp."
    }
    item magmaRavinesOptimal title="Magma Ravines" goal=sub15 parent=magmaRavinesEasy icon="item/kelp" label="Hitboxes" {
        description "Hitboxes and F5 under the water surface."
    }
    item oceanGravel title="Ocean Gravel" goal=sub30 parent=spawnScouting icon="block/gravel" {
        description "Gravel from the ocean floor for flint."
    }
    item underwaterTnt title="Underwater TNT" goal=sub13 parent=oceanGravel icon="block/tnt_side" label="Underwater" {
        description "TNT underwater for gravel and sand."
    }
}

category village title="Village" theme=overworld {
    item blacksmith title="Blacksmith Loot" goal=firstCompletion icon="item/iron_ingot" {
        description "Recognize and loot the blacksmith."
        ranked "A blacksmith within 7 chunks, with at least 7 iron counting the golem, or 4 iron and 3 diamonds."
    }
    item villageChecklist title="Village Checklist" goal=sub30 parent=blacksmith icon="block/hay_block_side" {
        description "10+ logs, 2 beds and about 7 hay bales."
    }
    item fishermanBucket title="Fisherman Bucket" goal=sub20 parent=villageChecklist icon="item/cod_bucket" {
        description "No bucket in the loot: buy a bucket of cod from a fisherman and place the fish."
    }
    item blacksmithObsidian title="Blacksmith Obsidian" goal=sub45 parent=blacksmith icon="block/obsidian" {
        description "Enter with the blacksmith's obsidian or go to the lava pools."
        ranked "Either 3 lava pools near the village or 8+ obsidian in the blacksmith."
    }
    item lootWithoutEntering title="Loot Without Entering" goal=sub13 parent=blacksmith icon="block/glass" {
        description "Mine logs or a window next to the chest."
    }
    item houseLayouts title="House Layouts" goal=sub12 parent=lootWithoutEntering icon="item/filled_map" {
        description "Memorize every house layout."
    }
    item golemEasy title="Iron Golem" goal=firstCompletion icon="block/carved_pumpkin" label="Tower" {
