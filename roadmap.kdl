category ruinedPortal title="Ruined Portal" theme=overworld {
    item ruinedPortalLoot title="Ruined Portal Loot" goal=sub30 icon="item/golden_helmet" {
        description "Loot the chest and take the gold armor; if it holds an axe, take it and break the chest with it."
    }
    item ruinedPortalEnter title="Obsidian or Bucket" goal=sub30 parent=ruinedPortalLoot icon="block/crying_obsidian" {
        description "Complete the portal's own obsidian, or cast a portal with the bucket."
        ranked "Enterable with the portal's obsidian or with a bucket, about 80/20."
    }
    item halfPortal title="Half Portal" goal=sub30 parent=ruinedPortalEnter icon="block/obsidian" label="Half" {
        description "Half the frame sunk in lava, two slabs on top; one obsidian to cast."
