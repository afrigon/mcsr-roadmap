goals {
    goal first-completion title="First Completion" short="1st"
    goal sub45 title="Sub 45" short="45"
    goal sub30 title="Sub 30" short="30"
    goal sub25 title="Sub 25" short="25" rank=coal
    goal sub20 title="Sub 20" short="20" rank=iron
    goal sub15 title="Sub 15" short="15" rank=gold
    goal sub13 title="Sub 13" short="13" rank=emerald
    goal sub12 title="Sub 12" short="12" rank=emerald
    goal sub11 title="Sub 11" short="11" rank=diamond
    goal sub10 title="Sub 10" short="10" rank=diamond
    goal sub9 title="Sub 9" short="9" rank=netherite
    goal sub8 title="Sub 8" short="8" rank=netherite
    goal sub7 title="Sub 7" short="7" rank=netherite
    goal sub6 title="Sub 6" short="6" rank=netherite
}

category setup title="Setup" theme=fundamentals {
    item install-ranked title="Install Ranked" goal=first-completion icon="item/knowledge_book" {
        description "Prism Launcher with the MCSR Ranked mod."
    }
    item optimized-java title="Optimized Java" goal=sub30 parent=install-ranked icon="block/furnace_front_on" {
        description "Java 17–22 with tuned memory and JVM arguments in Prism Launcher."
    }
    item core-settings title="Core Settings" goal=sub45 parent=install-ranked icon="item/comparator" {
        description "Brightness, GUI scale, FOV, subtitles on."
    }
    item standard-settings title="StandardSettings" goal=sub30 parent=core-settings icon="item/repeater" {
        description "Restores your settings on every world."
    }
    item chest-start-settings title="Chest Start Settings" goal=sub25 parent=standard-settings icon="item/clock_00" {
        description "Every world starts on chest-scan settings: render distance 8, entity distance 50%, pie chart preset."
    }
    item restore-settings title="Restore Settings" goal=sub20 parent=chest-start-settings icon="item/comparator" {
        description "Switch back to travel settings once the chest is found, or straight away on other seed types."
    }
    item basic-keybinds title="Basic Keybinds" goal=sub45 parent=install-ranked icon="block/lever" {
        description "Reachable hotbar slots and an offhand swap key."
    }
    item advanced-keybinds title="Advanced Keybinds" goal=sub25 parent=basic-keybinds icon="block/tripwire_hook" {
        description "Side-button F3 and perspective, a render-distance key that doesn't crouch, toggle sprint."
    }
    item wide-macro title="Wide Macro" goal=sub25 parent=advanced-keybinds icon="item/painting" label="Wide" {
        description "Wide resolution with planar fog for nether terrain, through Waywall or Toolscreen."
    }
    item thin-macro title="Thin Macro" goal=sub15 parent=wide-macro icon="item/painting" label="Thin" {
        description "Thin resolution for pinpointing pie-chart spikes."
    }
    item tall-macro title="Tall Macro" goal=sub13 parent=thin-macro icon="item/painting" label="Tall" {
        description "Tall resolution with eye zoom for measuring eyes."
    }
    item macro-rebinds title="Macro Rebinds" goal=sub13 parent=advanced-keybinds icon="item/redstone" {
        description "Strafe while holding F3 and tune key repeat through the macro tool."
    }
    item ghost-bucket title="Ghost Bucket Avoidance" goal=sub25 parent=basic-keybinds icon="item/water_bucket" {
        description "Keep the mouse still while using a bucket so it doesn't desync."
    }
    item read-f3 title="Read F3" goal=sub45 icon="item/compass_00" {
        description "Coordinates, facing direction and block coordinates."
    }
    item debug-keys title="Debug Keys" goal=sub45 parent=read-f3 icon="block/glass" {
        description "F3+G chunk borders, F3+B hitboxes, F5 third person, F3+C coordinates, Shift+F3 pie chart."
    }
    item run-overview title="The Run at a Glance" goal=first-completion icon="item/ender_eye" {
        description "Overworld, nether, bastion, fortress, blind, stronghold, End."
    }
    item seed-filter title="Seed Filter Guarantees" goal=sub45 parent=run-overview icon="item/wheat_seeds" {
        description "What each seed type promises, so you know what to look for."
        ranked "Each seed type guarantees its structure nearby, enough loot for the run and a way to enter the nether."
    }
    item mini-practice-kit title="MiniPracticeKit" goal=sub25 icon="item/book" {
        description "Drill hotbar and inventory habits on MiniPracticeKit."
    }
    item practice-map title="MCSR Practice Map" goal=sub25 parent=mini-practice-kit icon="item/map" {
        description "Dibedy's all-in-one practice map."
    }
}

category crafting title="Crafting" theme=fundamentals {
    item recipe-book title="Recipe Book" goal=first-completion icon="block/crafting_table_front" {
        description "Craft from the recipe book."
    }
    item tool-progression title="Tool Progression" goal=first-completion parent=recipe-book icon="item/stone_pickaxe" {
        description "Wood, then stone, then iron tools."
    }
    item iron-count-easy title="Crafting by Iron Count" goal=sub45 parent=tool-progression icon="item/iron_ingot" label="7 iron" {
        description "Seven iron: pickaxe, bucket, flint and steel."
    }
    item iron-count-optimal title="Crafting by Iron Count" goal=sub20 parent=iron-count-easy icon="item/iron_ingot" label="Every count" {
        description "What to craft with 6, 8, 9, 10–12 and 13+ iron, and when diamonds or shears are worth it."
    }
    item eyes-and-beds title="Eyes and Beds" goal=first-completion parent=recipe-book icon="item/blaze_powder" {
        description "Blaze powder and pearls into eyes, wool into beds."
    }
    item hotkey-crafting title="Hotkey Crafting" goal=sub30 parent=recipe-book icon="item/stick" {
        description "Drag-crafting, shift-clicking outputs, avoiding the button trap."
    }
    item tab-crafting title="Section Crafting" goal=sub15 parent=hotkey-crafting icon="item/paper" {
        description "Craft from the recipe book's category tabs instead of paging."
    }
    item recipe-book-slot title="Extra Recipe Slot" goal=sub13 parent=tab-crafting icon="item/item_frame" {
        description "The top-left recipe slot is one keypress away."
    }
    item search-crafting-easy title="Search Crafting" goal=sub12 parent=tab-crafting icon="item/name_tag" label="English" {
        description "Short English queries with Tab and Space."
    }
    item search-crafting-optimal title="Search Crafting" goal=sub6 parent=search-crafting-easy icon="item/name_tag" label="Short language" {
        description "A game language with shorter prefixes, such as Danish or Norwegian."
    }
}

category inventory title="Inventory" theme=fundamentals {
    item chest-looting title="Chest Looting" goal=first-completion icon="block/barrel_side" label="Basics" {
        description "Shift-click items out of a chest."
    }
    item fast-looting-easy title="Fast Looting" goal=sub45 parent=chest-looting icon="block/barrel_side" label="Spam" {
        description "Shift-click spam."
    }
    item fast-looting-standard title="Fast Looting" goal=sub25 parent=fast-looting-easy icon="block/barrel_side" label="Hotkey" {
        description "Shift plus hotkey or offhand clicks."
    }
    item fast-looting-optimal title="Fast Looting" goal=sub11 parent=fast-looting-standard icon="block/barrel_side" label="3-input" {
        description "Three-input, hotkeyless looting."
    }
    item consistent-hotbar-easy title="Consistent Hotbar" goal=sub30 icon="item/chest_minecart" label="Fixed slots" {
        description "The same slots for tools, blocks and food every run."
    }
    item consistent-hotbar-optimal title="Consistent Hotbar" goal=sub15 parent=consistent-hotbar-easy icon="item/chest_minecart" label="Whole run" {
        description "One layout for the whole run, with End slots fixed for muscle memory."
    }
    item inventory-on-the-move title="Inventory on the Move" goal=sub25 parent=consistent-hotbar-easy icon="item/rotten_flesh" {
        description "Throw junk and use the offhand as a buffer."
    }
    item mining-swap title="Mining Swap Gotcha" goal=sub45 icon="item/iron_pickaxe" {
        description "Swapping items resets mining progress."
    }
    item eat-while-pearling title="Eating While Pearling" goal=sub20 icon="composite/hunger" {
        description "Eat while a pearl is in the air instead of stopping to eat."
    }
    item craft-while-pearling title="Crafting While Pearling" goal=sub13 parent=eat-while-pearling icon="item/blaze_powder" {
        description "Craft eyes and blaze powder from the inventory grid mid-pearl."
    }
    item craft-while-travelling title="Crafting While Travelling" goal=sub12 parent=craft-while-pearling icon="block/crafting_table_front" {
        description "Nether brick, glowstone and wool on the way to the fortress; explosives and a bow at a table on the way to the stronghold coordinates."
    }
    item pick-block title="Pick Block" goal=sub12 icon="block/nether_bricks" {
        description "Middle-click to grab a block again: the hard block during blaze beds, nether brick while clearing, obsidian after the blind."
    }
}

category movement title="Movement" theme=fundamentals {
    item basic-movement title="Sprint, Pillar, Bridge" goal=first-completion icon="block/cobblestone" label="Basics" {
        description "Sprint jumping, pillaring and basic bridging."
    }
    item gap-block title="Gap Block" goal=sub12 parent=basic-movement icon="block/stone" {
        description "Place a block mid-jump to turn a 4-block gap into a 3-block jump."
    }
    item sneak-bridging title="Sneak Bridging" goal=sub30 parent=basic-movement icon="block/cobblestone" label="Sneak" {
        description "Bridge backward while sneaking at the edge."
    }
    item wall-bridging title="Wall Bridging" goal=sub15 parent=sneak-bridging icon="block/cobblestone" label="Wall" {
        description "Bridge along a wall as you run, placing against its side."
    }
    item speed-bridging title="Speed Bridging" goal=sub15 parent=sneak-bridging icon="block/cobblestone" label="Speed" {
        description "Release crouch right after each placement; about three times faster than sneak bridging."
    }
    item diagonal-bridging title="Diagonal Bridging" goal=sub12 parent=speed-bridging icon="block/cobblestone" label="Diagonal" {
        description "Bridge diagonally, placing at the corner, flat or stepping up."
    }
    item pillar-dropping title="Pillar While Dropping" goal=sub20 parent=basic-movement icon="block/dirt" {
        description "Pillar up while dropping items."
    }
    item speed-staircasing title="Speed Staircasing" goal=sub15 parent=basic-movement icon="block/obsidian" {
        description "Build a staircase upward without stopping; the first step of every zero-cycle setup."
    }
    item soul-sand-pillar title="Soul Sand Pillar" goal=sub13 parent=basic-movement icon="block/soul_sand" {
        description "Pillar up alternating soul sand and a solid block."
    }
    item soul-sand-lava title="Soul Sand Beside Lava" goal=sub25 icon="block/soul_sand" label="Lava" {
        description "Standing on soul sand level with lava sets you on fire: your hitbox reaches into the lava."
    }
    item soul-sand-edge title="Soul Sand Edge Fall" goal=sub25 icon="block/soul_sand" label="Edge" {
        description "Crouching doesn't stop you at an edge when you step from a full block onto soul sand."
    }
    item head-hitters title="Head Hitters" goal=sub15 icon="item/iron_helmet" label="Natural" {
        description "Sprint-jump under a low ceiling: each jump ends sooner, so you get the jump boost more often."
    }
    item self-placed-head-hitters title="Self-Placed Head Hitters" goal=sub11 parent=head-hitters icon="item/iron_helmet" label="Placed" {
        description "Place your own ceiling blocks on a route you've committed to."
    }
    item gravity-block-dig title="Dig Under Gravity Blocks" goal=sub11 icon="block/gravel" {
        description "Mine out the bottom of a sand or gravel column and walk through as it falls."
    }
    item floating-gravel title="Floating Gravel" goal=sub25 icon="block/gravel" label="Floating" {
        description "Generated floating gravel falls as soon as you place a block against its side."
    }
    item swimming title="Swimming and Air Pockets" goal=sub45 icon="item/kelp" {
        description "Breathe from door and bed air pockets."
    }
    item boat-travel title="Boat Travel" goal=sub30 parent=swimming icon="item/oak_boat" label="Travel" {
        description "Cross water by boat."
    }
    item boat-gap-jump title="Boat Gap Jump" goal=sub15 parent=boat-travel icon="item/oak_boat" label="Gap jump" {
        description "Jump a gap, place the boat on the far edge mid-air and ride the last stretch."
    }
    item boat-lava-clip title="Boat Lava Clip" goal=sub20 parent=boat-travel icon="item/oak_boat" label="Clip" {
        description "In a boat your hitbox reaches below the floor, so boating beside lava sets you on fire."
    }
    item boat-drop title="Boat Drop" goal=sub25 parent=boat-travel icon="item/oak_boat" label="Drop" {
        description "Ride a boat off a drop: the boat cancels fall damage, except at a few exact heights."
    }
    item boat-exit-early title="Exit Early" goal=sub20 parent=boat-drop icon="item/oak_boat" label="Exit" {
        description "Leave the boat just before it lands, so a boat-break height can't kill you."
    }
    item boat-re-entry title="Boat Re-Entry" goal=sub15 parent=boat-drop icon="item/oak_boat" label="Re-entry" {
        description "Exit and re-enter the boat while riding down terrain to go farther."
    }
    item boat-crawl title="Boat Crawl" goal=sub13 parent=boat-travel icon="item/oak_boat" label="Crawl" {
        description "Crawl through tight spaces in a boat."
    }
    item sprint-crawl-boat title="Sprint-Crawl Boat" goal=sub10 parent=boat-crawl icon="item/oak_boat" label="Sprint-crawl" {
        description "Sprint into the crawl for a faster boat crawl."
    }
    item pearl-basics title="Ender Pearl Basics" goal=sub45 icon="item/ender_pearl" label="Basics" {
        description "Throwing ender pearls."
    }
    item pearl-travel title="Pearl Travel Angles" goal=sub25 parent=pearl-basics icon="item/ender_pearl" label="Angles" {
        description "Sprint-jump throws for distance."
    }
    item pearl-hang title="Pearl Hang" goal=sub12 parent=pearl-basics icon="item/ender_pearl" label="Hang" {
        description "Render distance 2 freezes a pearl in the air."
    }
    item pearl-crawl title="Pearl Crawl" goal=sub11 parent=pearl-basics icon="item/ender_pearl" label="Crawl" {
        description "Pearl into a crawl space."
    }
    item water-clutch title="Water Bucket Clutch" goal=sub30 icon="item/water_bucket" {
        description "Place water just before landing."
    }
    item pearl-clutch title="Pearl Clutch" goal=sub25 parent=water-clutch icon="item/ender_pearl" label="Clutch" {
        description "Pearl down instead of taking the fall."
    }
    item block-clutch title="Block Clutch" goal=sub20 parent=pearl-clutch icon="block/stone" {
        description "Pearl onto a wall and place a block on landing."
    }
    item boat-clutch-easy title="Boat Clutch" goal=sub15 parent=water-clutch icon="item/oak_boat" label="Butterfly" {
        description "Place a boat under you with butterfly clicking."
    }
    item boat-clutch-optimal title="Boat Clutch" goal=sub12 parent=boat-clutch-easy icon="item/oak_boat" label="Drag click" {
        description "Place the boat with drag clicking."
    }
    item knockback-cancel title="Knockback Cancel" goal=sub13 icon="item/flint_and_steel" {
        description "Set yourself on fire just before a hit."
    }
}

category overworld title="Overworld" theme=overworld {
