    }
    item golemOptimal title="Iron Golem" goal=sub30 parent=golemEasy icon="block/carved_pumpkin" label="Crits" {
        description "Crit with the axe on cooldown, or with an iron sword on every jump."
    }
    item hayAndBeds title="Hay and Beds" goal=firstCompletion icon="item/bread" {
        description "Hay bales into bread, beds from houses."
    }
    item desertVillages title="Desert Villages" goal=sub25 parent=hayAndBeds icon="block/dead_bush" {
        description "Sticks from dead bushes, wood from the nether."
    }
    item snowyTaigaVillages title="Snowy and Taiga Villages" goal=sub20 parent=hayAndBeds icon="block/spruce_log" {
        description "Their blacksmith variants and where the obsidian is."
