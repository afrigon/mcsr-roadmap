goals {
    goal firstCompletion title="First Completion" short="1st"
    goal sub45 title="Sub 45" short="45"
    goal sub30 title="Sub 30" short="30"
    goal sub25 title="Sub 25" short="25" rank=coal
    goal sub20 title="Sub 20" short="20" rank=iron
    goal sub15 title="Sub 15" short="15" rank=gold
    goal sub13 title="Sub 13" short="13" rank=emerald
    goal sub12 title="Sub 12" short="12" rank=emerald
    goal sub11 title="Sub 11" short="11" rank=diamond
    goal sub10 title="Sub 10" short="10" rank=diamond
    goal sub9 title="Sub 9" short="9" rank=netherite
    goal sub8 title="Sub 8" short="8" rank=netherite
    goal sub7 title="Sub 7" short="7" rank=netherite
    goal sub6 title="Sub 6" short="6" rank=netherite
}

category setup title="Setup" theme=fundamentals {
    item installRanked title="Install Ranked" goal=firstCompletion icon="item/knowledge_book" {
        description "Prism Launcher with the MCSR Ranked mod."
    }
    item optimizedJava title="Optimized Java" goal=sub30 parent=installRanked icon="block/furnace_front_on" {
        description "Java 17–22 with tuned memory and JVM arguments in Prism Launcher."
    }
    item coreSettings title="Core Settings" goal=sub45 parent=installRanked icon="item/comparator" {
        description "Brightness, GUI scale, FOV, subtitles on."
    }
    item standardSettings title="StandardSettings" goal=sub30 parent=coreSettings icon="item/repeater" {
        description "Restores your settings on every world."
    }
    item chestStartSettings title="Chest Start Settings" goal=sub25 parent=standardSettings icon="item/clock_00" {
        description "Every world starts on chest-scan settings: render distance 8, entity distance 50%, pie chart preset."
    }
    item restoreSettings title="Restore Settings" goal=sub20 parent=chestStartSettings icon="item/comparator" {
        description "Switch back to travel settings once the chest is found, or straight away on other seed types."
    }
    item basicKeybinds title="Basic Keybinds" goal=sub45 parent=installRanked icon="block/lever" {
        description "Reachable hotbar slots and an offhand swap key."
    }
    item advancedKeybinds title="Advanced Keybinds" goal=sub25 parent=basicKeybinds icon="block/tripwire_hook" {
        description "Side-button F3 and perspective, a render-distance key that doesn't crouch, toggle sprint."
    }
    item wideMacro title="Wide Macro" goal=sub25 parent=advancedKeybinds icon="item/painting" label="Wide" {
        description "Wide resolution with planar fog for nether terrain, through Waywall or Toolscreen."
    }
    item thinMacro title="Thin Macro" goal=sub15 parent=wideMacro icon="item/painting" label="Thin" {
        description "Thin resolution for pinpointing pie-chart spikes."
    }
    item tallMacro title="Tall Macro" goal=sub13 parent=thinMacro icon="item/painting" label="Tall" {
        description "Tall resolution with eye zoom for measuring eyes."
    }
    item macroRebinds title="Macro Rebinds" goal=sub13 parent=advancedKeybinds icon="item/redstone" {
        description "Strafe while holding F3 and tune key repeat through the macro tool."
    }
    item ghostBucket title="Ghost Bucket Avoidance" goal=sub25 parent=basicKeybinds icon="item/water_bucket" {
        description "Keep the mouse still while using a bucket so it doesn't desync."
    }
    item readF3 title="Read F3" goal=sub45 icon="item/compass_00" {
        description "Coordinates, facing direction and block coordinates."
    }
    item debugKeys title="Debug Keys" goal=sub45 parent=readF3 icon="block/glass" {
        description "F3+G chunk borders, F3+B hitboxes, F5 third person, F3+C coordinates, Shift+F3 pie chart."
    }
    item runOverview title="The Run at a Glance" goal=firstCompletion icon="item/ender_eye" {
        description "Overworld, nether, bastion, fortress, blind, stronghold, End."
    }
    item seedFilter title="Seed Filter Guarantees" goal=sub45 parent=runOverview icon="item/wheat_seeds" {
        description "What each seed type promises, so you know what to look for."
        ranked "Each seed type guarantees its structure nearby, enough loot for the run and a way to enter the nether."
    }
    item miniPracticeKit title="MiniPracticeKit" goal=sub25 icon="item/book" {
        description "Drill hotbar and inventory habits on MiniPracticeKit."
    }
    item practiceMap title="MCSR Practice Map" goal=sub25 parent=miniPracticeKit icon="item/map" {
        description "Dibedy's all-in-one practice map."
    }
}

category crafting title="Crafting" theme=fundamentals {
    item recipeBook title="Recipe Book" goal=firstCompletion icon="block/crafting_table_front" {
        description "Craft from the recipe book."
    }
    item toolProgression title="Tool Progression" goal=firstCompletion parent=recipeBook icon="item/stone_pickaxe" {
        description "Wood, then stone, then iron tools."
    }
    item ironCountEasy title="Crafting by Iron Count" goal=sub45 parent=toolProgression icon="item/iron_ingot" label="7 iron" {
        description "Seven iron: pickaxe, bucket, flint and steel."
    }
    item ironCountOptimal title="Crafting by Iron Count" goal=sub20 parent=ironCountEasy icon="item/iron_ingot" label="Every count" {
        description "What to craft with 6, 8, 9, 10–12 and 13+ iron, and when diamonds or shears are worth it."
    }
    item eyesAndBeds title="Eyes and Beds" goal=firstCompletion parent=recipeBook icon="item/blaze_powder" {
        description "Blaze powder and pearls into eyes, wool into beds."
    }
    item hotkeyCrafting title="Hotkey Crafting" goal=sub30 parent=recipeBook icon="item/stick" {
        description "Drag-crafting, shift-clicking outputs, avoiding the button trap."
    }
    item tabCrafting title="Section Crafting" goal=sub15 parent=hotkeyCrafting icon="item/paper" {
        description "Craft from the recipe book's category tabs instead of paging."
    }
    item recipeBookSlot title="Extra Recipe Slot" goal=sub13 parent=tabCrafting icon="item/item_frame" {
        description "The top-left recipe slot is one keypress away."
    }
    item searchCraftingEasy title="Search Crafting" goal=sub12 parent=tabCrafting icon="item/name_tag" label="English" {
        description "Short English queries with Tab and Space."
    }
    item searchCraftingOptimal title="Search Crafting" goal=sub6 parent=searchCraftingEasy icon="item/name_tag" label="Short language" {
        description "A game language with shorter prefixes, such as Danish or Norwegian."
    }
}

category inventory title="Inventory" theme=fundamentals {
    item chestLooting title="Chest Looting" goal=firstCompletion icon="block/barrel_side" label="Basics" {
        description "Shift-click items out of a chest."
    }
    item fastLootingEasy title="Fast Looting" goal=sub45 parent=chestLooting icon="block/barrel_side" label="Spam" {
        description "Shift-click spam."
    }
    item fastLootingStandard title="Fast Looting" goal=sub25 parent=fastLootingEasy icon="block/barrel_side" label="Hotkey" {
        description "Shift plus hotkey or offhand clicks."
    }
    item fastLootingOptimal title="Fast Looting" goal=sub11 parent=fastLootingStandard icon="block/barrel_side" label="3-input" {
        description "Three-input, hotkeyless looting."
    }
    item consistentHotbarEasy title="Consistent Hotbar" goal=sub30 icon="item/chest_minecart" label="Fixed slots" {
        description "The same slots for tools, blocks and food every run."
    }
    item consistentHotbarOptimal title="Consistent Hotbar" goal=sub15 parent=consistentHotbarEasy icon="item/chest_minecart" label="Whole run" {
        description "One layout for the whole run, with End slots fixed for muscle memory."
    }
    item inventoryOnTheMove title="Inventory on the Move" goal=sub25 parent=consistentHotbarEasy icon="item/rotten_flesh" {
        description "Throw junk and use the offhand as a buffer."
    }
    item miningSwap title="Mining Swap Gotcha" goal=sub45 icon="item/iron_pickaxe" {
        description "Swapping items resets mining progress."
    }
    item eatWhilePearling title="Eating While Pearling" goal=sub20 icon="composite/hunger" {
        description "Eat while a pearl is in the air instead of stopping to eat."
    }
    item craftWhilePearling title="Crafting While Pearling" goal=sub13 parent=eatWhilePearling icon="item/blaze_powder" {
        description "Craft eyes and blaze powder from the inventory grid mid-pearl."
    }
    item craftWhileTravelling title="Crafting While Travelling" goal=sub12 parent=craftWhilePearling icon="block/crafting_table_front" {
        description "Nether brick, glowstone and wool on the way to the fortress; explosives and a bow at a table on the way to the stronghold coordinates."
    }
    item pickBlock title="Pick Block" goal=sub12 icon="block/nether_bricks" {
        description "Middle-click to grab a block again: the hard block during blaze beds, nether brick while clearing, obsidian after the blind."
    }
}

category movement title="Movement" theme=fundamentals {
    item basicMovement title="Sprint, Pillar, Bridge" goal=firstCompletion icon="block/cobblestone" label="Basics" {
        description "Sprint jumping, pillaring and basic bridging."
    }
    item gapBlock title="Gap Block" goal=sub12 parent=basicMovement icon="block/stone" {
        description "Place a block mid-jump to turn a 4-block gap into a 3-block jump."
    }
    item sneakBridging title="Sneak Bridging" goal=sub30 parent=basicMovement icon="block/cobblestone" label="Sneak" {
        description "Bridge backward while sneaking at the edge."
    }
    item wallBridging title="Wall Bridging" goal=sub15 parent=sneakBridging icon="block/cobblestone" label="Wall" {
        description "Bridge along a wall as you run, placing against its side."
    }
    item speedBridging title="Speed Bridging" goal=sub15 parent=sneakBridging icon="block/cobblestone" label="Speed" {
        description "Release crouch right after each placement; about three times faster than sneak bridging."
    }
    item diagonalBridging title="Diagonal Bridging" goal=sub12 parent=speedBridging icon="block/cobblestone" label="Diagonal" {
        description "Bridge diagonally, placing at the corner, flat or stepping up."
    }
    item pillarDropping title="Pillar While Dropping" goal=sub20 parent=basicMovement icon="block/dirt" {
        description "Pillar up while dropping items."
    }
    item speedStaircasing title="Speed Staircasing" goal=sub15 parent=basicMovement icon="block/obsidian" {
        description "Build a staircase upward without stopping; the first step of every zero-cycle setup."
    }
    item soulSandPillar title="Soul Sand Pillar" goal=sub13 parent=basicMovement icon="block/soul_sand" {
        description "Pillar up alternating soul sand and a solid block."
    }
    item soulSandLava title="Soul Sand Beside Lava" goal=sub25 icon="block/soul_sand" label="Lava" {
        description "Standing on soul sand level with lava sets you on fire: your hitbox reaches into the lava."
    }
    item soulSandEdge title="Soul Sand Edge Fall" goal=sub25 icon="block/soul_sand" label="Edge" {
        description "Crouching doesn't stop you at an edge when you step from a full block onto soul sand."
    }
    item headHitters title="Head Hitters" goal=sub15 icon="item/iron_helmet" label="Natural" {
        description "Sprint-jump under a low ceiling: each jump ends sooner, so you get the jump boost more often."
    }
    item selfPlacedHeadHitters title="Self-Placed Head Hitters" goal=sub11 parent=headHitters icon="item/iron_helmet" label="Placed" {
        description "Place your own ceiling blocks on a route you've committed to."
    }
    item gravityBlockDig title="Dig Under Gravity Blocks" goal=sub11 icon="block/gravel" {
        description "Mine out the bottom of a sand or gravel column and walk through as it falls."
    }
    item floatingGravel title="Floating Gravel" goal=sub25 icon="block/gravel" label="Floating" {
        description "Generated floating gravel falls as soon as you place a block against its side."
    }
    item swimming title="Swimming and Air Pockets" goal=sub45 icon="item/kelp" {
        description "Breathe from door and bed air pockets."
    }
    item boatTravel title="Boat Travel" goal=sub30 parent=swimming icon="item/oak_boat" label="Travel" {
        description "Cross water by boat."
    }
    item boatGapJump title="Boat Gap Jump" goal=sub15 parent=boatTravel icon="item/oak_boat" label="Gap jump" {
        description "Jump a gap, place the boat on the far edge mid-air and ride the last stretch."
    }
    item boatLavaClip title="Boat Lava Clip" goal=sub20 parent=boatTravel icon="item/oak_boat" label="Clip" {
        description "In a boat your hitbox reaches below the floor, so boating beside lava sets you on fire."
    }
    item boatDrop title="Boat Drop" goal=sub25 parent=boatTravel icon="item/oak_boat" label="Drop" {
        description "Ride a boat off a drop: the boat cancels fall damage, except at a few exact heights."
    }
    item boatExitEarly title="Exit Early" goal=sub20 parent=boatDrop icon="item/oak_boat" label="Exit" {
        description "Leave the boat just before it lands, so a boat-break height can't kill you."
    }
    item boatReEntry title="Boat Re-Entry" goal=sub15 parent=boatDrop icon="item/oak_boat" label="Re-entry" {
        description "Exit and re-enter the boat while riding down terrain to go farther."
    }
    item boatCrawl title="Boat Crawl" goal=sub13 parent=boatTravel icon="item/oak_boat" label="Crawl" {
        description "Crawl through tight spaces in a boat."
    }
    item sprintCrawlBoat title="Sprint-Crawl Boat" goal=sub10 parent=boatCrawl icon="item/oak_boat" label="Sprint-crawl" {
        description "Sprint into the crawl for a faster boat crawl."
    }
    item pearlBasics title="Ender Pearl Basics" goal=sub45 icon="item/ender_pearl" label="Basics" {
        description "Throwing ender pearls."
    }
    item pearlTravel title="Pearl Travel Angles" goal=sub25 parent=pearlBasics icon="item/ender_pearl" label="Angles" {
        description "Sprint-jump throws for distance."
    }
    item pearlHang title="Pearl Hang" goal=sub12 parent=pearlBasics icon="item/ender_pearl" label="Hang" {
        description "Render distance 2 freezes a pearl in the air."
    }
    item pearlCrawl title="Pearl Crawl" goal=sub11 parent=pearlBasics icon="item/ender_pearl" label="Crawl" {
        description "Pearl into a crawl space."
    }
    item waterClutch title="Water Bucket Clutch" goal=sub30 icon="item/water_bucket" {
        description "Place water just before landing."
    }
    item pearlClutch title="Pearl Clutch" goal=sub25 parent=waterClutch icon="item/ender_pearl" label="Clutch" {
        description "Pearl down instead of taking the fall."
    }
    item blockClutch title="Block Clutch" goal=sub20 parent=pearlClutch icon="block/stone" {
        description "Pearl onto a wall and place a block on landing."
    }
    item boatClutchEasy title="Boat Clutch" goal=sub15 parent=waterClutch icon="item/oak_boat" label="Butterfly" {
        description "Place a boat under you with butterfly clicking."
    }
    item boatClutchOptimal title="Boat Clutch" goal=sub12 parent=boatClutchEasy icon="item/oak_boat" label="Drag click" {
        description "Place the boat with drag clicking."
    }
    item knockbackCancel title="Knockback Cancel" goal=sub13 icon="item/flint_and_steel" {
        description "Set yourself on fire just before a hit."
    }
}

category overworld title="Overworld" theme=overworld {
    item punchTrees title="Punch Trees" goal=firstCompletion icon="block/oak_log" {
        description "Gather 10+ logs."
    }
    item tntTrees title="TNT for Trees" goal=sub25 parent=punchTrees icon="block/tnt_side" label="Trees" {
        description "One TNT between two close trees for fast logs."
    }
    item tntCannon title="TNT Cannon" goal=sub12 parent=tntTrees icon="block/tnt_side" label="Cannon" {
        description "Use one TNT's blast to push a second TNT onto a distant tree."
    }
