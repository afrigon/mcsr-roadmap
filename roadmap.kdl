    }
    item tnt4 title="4 TNT" goal=sub11 parent=tnt3 icon="block/tnt_side" label="4 TNT" {
        description "Sides, then rear, then front; block one side so a jumping TNT can't break the spawner. The default on a buried spawner."
    }
    item double-blaze-bed title="Double Blaze Bed" goal=sub20 parent=spawner-clearing icon="composite/bed" label="2 beds" {
        description "Clear the spawner with two beds over hard blocks."
    }
    item single-bed-enclosed title="Single Blaze Bed" goal=sub15 parent=double-blaze-bed icon="composite/bed" label="Enclosed" {
        description "One bed on a buried spawner: mine into the roof, hard block on the spawner, bed above."
    }
    item single-bed-open title="Single Blaze Bed" goal=sub15 parent=double-blaze-bed icon="composite/bed" label="Open" {
        description "Hard block on the spawner, two soft blocks, bed above; then clear the fire."
    }
    item setup-choice title="Choosing a Setup" goal=sub12 parent=spawner-clearing icon="item/writable_book" {
        description "Pick by explosive count, open or buried and rods held; keep enough explosives for the End."
    }
    item rare-setups title="Rare Setups" goal=sub10 parent=setup-choice icon="block/tnt_side" label="Mixed" {
        description "1 TNT, 1 TNT plus a bed, 2 TNT plus a bed and the other combinations."
    }
    item wither-skeletons title="Wither Skeletons" goal=sub45 icon="item/stone_sword" label="Pillar" {
        description "Pillar beside the edge and punch them off."
    }
    item wither-ledge title="Wither Ledge Trick" goal=sub20 parent=wither-skeletons icon="item/stone_sword" label="L shape" {
        description "With no edge, add one block in an L so they step out and fall."
    }
    item wither-block-enclosed title="Block a Hallway" goal=sub15 parent=wither-skeletons icon="item/stone_sword" label="Enclosed" {
        description "They can't fit through a 2-high gap: block the top or bottom of a passage so they can't follow."
    }
    item wither-block-open title="Block an Open Hallway" goal=sub13 parent=wither-block-enclosed icon="item/stone_sword" label="Open" {
        description "Build a line across the bridge so late withers can't reach the spawner."
    }
    item wither-trap title="Wither Trap" goal=sub12 parent=wither-block-enclosed icon="item/stone_sword" label="Trap" {
        description "Lead them into a capped pathway, then block the other end."
    }
    item wither-fire-path title="Fire Pathing" goal=sub11 parent=wither-ledge icon="item/stone_sword" label="Fire" {
        description "Place fire on the bridge so they route to the edge, then hit them off."
    }
    item fort-first title="Fort First" goal=sub13 icon="item/golden_apple" {
        description "Go to the fortress first with a shield or an enchanted golden apple."
    }
}

category finding-stronghold title="Finding the Stronghold" theme=stronghold {
    item follow-eyes title="Follow the Eyes" goal=first-completion icon="item/ender_eye" label="Follow" {
        description "Throw eyes and follow them."
    }
    item ninjabrain-easy title="Ninjabrain Bot" goal=sub45 parent=follow-eyes icon="item/ender_eye" label="2 eyes" {
        description "Two-eye triangulation with Ninjabrain Bot."
    }
    item fov30-measuring title="FOV 30 Measuring" goal=sub20 parent=ninjabrain-easy icon="item/ender_eye" label="FOV 30" {
        description "Measure at FOV 30 and calibrate the standard deviation."
    }
    item measurement-desync title="Measurement Desync" goal=sub13 parent=ninjabrain-easy icon="item/ender_eye" label="Desync" {
        description "Eyes spawn at the server's copy of your position: jump once fully stopped, or stand still a second, before throwing."
    }
    item tall-zoom title="Tall Zoom" goal=sub15 parent=fov30-measuring icon="item/ender_eye" label="Zoom" {
        description "Tall resolution, zoom and pixel adjustment."
    }
    item eye-wiggle title="Eye Wiggle" goal=sub12 parent=tall-zoom icon="item/ender_eye" label="Wiggle" {
        description "The eye flips between two pixel offsets: measure both and trust only a matching result."
    }
    item boat-eye title="Boat Eye" goal=sub20 parent=fov30-measuring icon="item/oak_boat" label="Eye" {
        description "Single-eye measuring from a boat."
    }
    item god-sensitivity title="God Sensitivity" goal=sub15 parent=boat-eye icon="item/oak_boat" label="Sensitivity" {
        description "A mouse sensitivity that keeps boat angles exact, so entering the boat needs no F3+C."
    }
    item boat-during-portal title="Boat During Portal" goal=sub13 parent=god-sensitivity icon="item/oak_boat" label="Portal" {
        description "Get in and out of the boat for boat eye during the portal animation, not after arriving."
    }
    item dig-in title="Dig In at 4,4" goal=sub45 parent=follow-eyes icon="item/iron_shovel" {
        description "Dig down at block 4,4 of the stronghold chunk."
    }
    item blind-easy title="Blind Portal" goal=sub30 icon="block/obsidian" label="Rating" {
        description "Build the first portal back once its F3+C rating says good or excellent."
    }
    item blind-optimal title="Blind Portal" goal=sub20 parent=blind-easy icon="block/obsidian" label="Head X°" {
        description "Keep travelling toward \"head X°\" until the rating is excellent."
        ranked "Building at Y48 or higher in the nether guarantees a surface exit."
    }
    item eye-pearl-recovery title="Eye Pearl Recovery" goal=sub15 parent=blind-optimal icon="item/ender_pearl" {
        description "Over an ocean, pearl after a thrown eye to pick it up before it's lost."
    }
    item fast-blind-build title="Fast Blind Portal" goal=sub20 parent=blind-easy icon="block/obsidian" label="Fast build" {
        description "Build the blind portal fast, at the end of a spawner cycle."
    }
    item home-portal-blind title="Home Portal Blind" goal=sub25 parent=blind-easy icon="block/obsidian" label="Home portal" {
        description "Low on obsidian: measure from the home portal instead of building a blind."
    }
    item double-travel title="Double Travel" goal=sub30 parent=blind-easy icon="block/crying_obsidian" {
        description "Go back through and build at the bot's nether coordinates; 20 obsidian."
    }
    item portal-linking title="Portal Linking" goal=sub25 parent=double-travel icon="block/nether_portal" label="Linking" {
        description "A close stronghold links the second portal back to the first."
    }
    item neighbouring-offsets title="Neighbouring Offsets" goal=sub13 parent=double-travel icon="block/nether_portal" label="Offsets" {
        description "One portal between two adjacent candidate chunks."
    }
    item blind-hunger-reset title="Hunger Reset at Blind" goal=sub13 parent=blind-easy icon="composite/hunger" label="Blind" {
        description "Reset hunger with a bed and a 2×1 hole at the blind."
    }
    item early-blind-reset title="Early Blind Reset" goal=sub12 parent=blind-hunger-reset icon="composite/hunger" label="Early" {
        description "Build the blind early when you need a hunger reset."
    }
    item ocean-blind-reset title="Ocean Blind Reset" goal=sub11 parent=blind-hunger-reset icon="composite/hunger" label="Ocean" {
        description "Hunger reset when the blind exits onto water."
    }
    item ocean-exposed title="Ocean Exposed" goal=sub11 parent=blind-easy icon="block/prismarine" {
        description "When the blind exits onto ocean, go out to spot the stronghold and skip the second eye."
    }
}

